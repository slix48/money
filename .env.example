DATABASE_URL="postgresql://moneyos:moneyos@localhost:5432/moneyos?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
DEMO_MODE="true"

# Optional connected-data integration. Demo mode works without these values.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_WEBHOOK_URL="http://localhost:3000/api/providers/plaid/webhook"
PLAID_REDIRECT_URI="http://localhost:3000/settings"

# Legacy single key. Generate 32 random bytes and encode it as base64.
PROVIDER_TOKEN_ENCRYPTION_KEY=""

# Preferred rotation-ready configuration. Do not set this with the legacy key.
# PROVIDER_TOKEN_ENCRYPTION_KEYS='{"1":"base64-key","2":"base64-key"}'
# PROVIDER_TOKEN_ENCRYPTION_KEY_VERSION="2"

# Optional in sandbox; required for production Plaid. Use at least 32 characters.
CRON_SECRET=""
